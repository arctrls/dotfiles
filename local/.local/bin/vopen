#!/usr/bin/env sh

socket=$(nvim-remote-socket)

if [ ! -S "$socket" ]; then
  printf 'vopen: Neovim remote socket not found: %s\n' "$socket" >&2
  printf 'vopen: start Neovim with: vlisten .\n' >&2
  exit 1
fi

if [ "$#" -lt 1 ]; then
  printf 'usage: vopen FILE [LINE]\n' >&2
  exit 2
fi

file=$1
line=${2:-1}

if [ "$#" -lt 2 ]; then
  case "$file" in
    *:*)
      candidate=${file%:*}
      candidate_line=${file##*:}
      if [ -e "$candidate" ] && [ "$candidate_line" -eq "$candidate_line" ] 2>/dev/null; then
        file=$candidate
        line=$candidate_line
      fi
      ;;
  esac
fi

nvim --server "$socket" --remote-silent "$file"
nvim --server "$socket" --remote-send "<Esc>:$line<CR>"
